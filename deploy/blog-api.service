[Unit]
Description=Blog API Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/blog/backend
Environment=DATABASE_URL=sqlite:/opt/blog/backend/blog.db?mode=rwc
Environment=RUST_LOG=info
Environment=JWT_SECRET=${JWT_SECRET}
ExecStart=/opt/blog/backend/target/release/blog-backend
Restart=always
RestartSec=10
StandardOutput=append:/opt/blog/logs/api.log
StandardError=append:/opt/blog/logs/api.error.log

[Install]
WantedBy=multi-user.target
